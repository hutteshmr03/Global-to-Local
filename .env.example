# Global to Local — Backend & Frontend Environment Configuration
ENV=development
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/gtl_db
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/gtl_test_db
REDIS_URL=redis://127.0.0.1:6379/0

# Security & Cookies
JWT_SECRET_KEY=replace-with-strong-64-byte-secret-in-production
CSRF_SECRET_KEY=replace-with-strong-64-byte-csrf-secret-in-production
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Razorpay (Test mode defaults for local development; replace with live keys in production)
RAZORPAY_KEY_ID=rzp_test_gtl_goa_dev_key
RAZORPAY_KEY_SECRET=rzp_test_gtl_goa_dev_secret_key_998877
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_gtl_goa_dev_webhook_secret_112233

# SMS, Email & CAPTCHA Providers
# NOTE: ENV=production strictly refuses SMS_PROVIDER=console, EMAIL_PROVIDER=console, and in-memory Redis fallback.
SMS_PROVIDER=console
SMS_API_KEY=
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=orders@globaltolocal.in
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA

